{
  "name": "art-community-backend",
  "version": "1.0.0",
  "description": "Backend for Global Artist Community Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node --use-system-ca --max-old-space-size=4096 -r ts-node/register\" src/server.ts",
    "seed": "node -r ts-node/register src/seed_all.ts",
    "reset-fresh": "node -r ts-node/register src/reset_db_fresh.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@types/pg": "^8.16.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.11.3",
    "razorpay": "^2.9.6",
    "socket.io": "^4.7.2",
    "stripe": "^13.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.6.0",
    "@types/nodemailer": "^7.0.9",
    "mongodb-memory-server": "^8.12.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  }
}
